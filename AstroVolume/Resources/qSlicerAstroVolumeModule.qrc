        <!-- TwoSurfaces -->
        <file alias="Surfaces at 3σ, 7σ">Icons/Presets/TwoSurfaces.png</file>
        <!-- ThreeSurfaces -->
        <file alias="Surfaces at 3σ, 7σ, 15σ">Icons/Presets/ThreeSurfaces.png</file>
        <!-- BrightSurfaces -->
        <file alias="Surfaces every 3σ · rainbow">Icons/Presets/BrightSurfaces.png</file>
        <!-- ObservatorySurfaces -->
        <file alias="Surfaces at 3σ, 7σ, 15σ · Observatory">Icons/Presets/ObservatorySurfaces.png</file>
